---
import Page from "@layouts/Page.astro";
import { getBlogPosts, getPostUrl, sortPostsByDateDesc } from "@utils/blog";
import { formatPostDate } from "@utils/date";
import type { GetStaticPaths, Page as PaginatedPage } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const blogPosts = sortPostsByDateDesc(await getBlogPosts());

  return paginate(blogPosts, { pageSize: 9 });
}) satisfies GetStaticPaths;

interface Props {
  page: PaginatedPage<CollectionEntry<"blog">>;
}

const { page } = Astro.props;

const pages = await getCollection("pages");
const blogPage = pages.find((p) => p.id === "blog");
const pageTitle = blogPage?.data.title ?? "記事一覧";
const pageDescription =
  blogPage?.data.description ?? "CoderDojo 奈良の活動報告や関連情報のブログ記事一覧です。";

const pageUrl = (n: number) => (n === 1 ? "/blog/" : `/blog/${n}/`);

// ページネーションの表示番号（先頭・末尾・現在の前後を表示し、間は … で省略）
const current = page.currentPage;
const last = page.lastPage;
const pageItems: (number | "ellipsis")[] = [];
for (let n = 1; n <= last; n++) {
  if (n === 1 || n === last || (n >= current - 1 && n <= current + 1)) {
    pageItems.push(n);
  } else if (pageItems[pageItems.length - 1] !== "ellipsis") {
    pageItems.push("ellipsis");
  }
}
---

<Page
  title={pageTitle}
  description={pageDescription}
>
  <div class="dj-page-header">
    <div class="dj-page-header__inner">
      <p class="dj-page-eyebrow">BLOG</p>
      <h1 class="dj-page-header__title">記事一覧</h1>
      <p class="dj-page-header__lead">Dojoの開催レポートやお知らせをお届けします。</p>
    </div>
  </div>

  <section class="dj-wrap dj-wrap--narrow post-list">
    {
      page.data.length > 0 ? (
        <div class="post-list__items">
          {page.data.map((post) => (
            <a
              href={getPostUrl(post)}
              class="post-row"
            >
              <span class="post-row__date">{formatPostDate(post.data.date)}</span>
              <span class="post-row__author">{post.data.author}</span>
              <span class="post-row__title">{post.data.title}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="post-list__empty">まだ記事がありません。</p>
      )
    }

    {
      last > 1 && (
        <nav
          class="pagination"
          aria-label="ページ送り"
        >
          {pageItems.map((item) =>
            item === "ellipsis" ? (
              <span class="pagination__ellipsis">…</span>
            ) : item === current ? (
              <span
                class="pagination__item pagination__item--current"
                aria-current="page"
              >
                {item}
              </span>
            ) : (
              <a
                href={pageUrl(item)}
                class="pagination__item"
              >
                {item}
              </a>
            )
          )}
        </nav>
      )
    }
  </section>
</Page>

<style>
  .post-list {
    padding: 24px 32px 40px;
    display: flex;
    flex-direction: column;
  }

  .post-list__items {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: grid;
    grid-template-columns: 130px 90px 1fr;
    gap: 20px;
    padding: 22px 8px;
    border-bottom: 1px solid var(--brand-border-hairline);
    align-items: baseline;
    color: var(--brand-ink);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .post-row:hover {
    opacity: 0.75;
  }

  .post-row__date {
    font-size: 13px;
    color: var(--brand-ink-muted);
  }

  .post-row__author {
    font-size: 12px;
    font-weight: var(--font-weight-bold);
    color: var(--brand-amber);
  }

  .post-row__title {
    font-weight: var(--font-weight-bold);
    font-size: 16px;
    line-height: 1.7;
  }

  .post-list__empty {
    text-align: center;
    color: var(--brand-ink-sub);
    padding: 40px 0;
  }

  /* ページネーション */
  .pagination {
    display: flex;
    gap: 8px;
    justify-content: center;
    padding: 40px 0 8px;
    flex-wrap: wrap;
  }

  .pagination__item {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    color: var(--brand-navy);
    border: 1px solid var(--brand-border);
    transition: opacity 0.15s ease;
  }

  .pagination__item:hover {
    opacity: 0.75;
  }

  .pagination__item--current {
    background: var(--brand-navy);
    color: #fff;
    border-color: var(--brand-navy);
  }

  .pagination__ellipsis {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-ink-muted);
  }

  @media (width < 640px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .post-row__author {
      order: 3;
    }
  }
</style>

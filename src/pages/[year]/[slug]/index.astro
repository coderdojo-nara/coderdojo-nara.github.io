---
import Gallery from "@components/Gallery.astro";
import Page from "@layouts/Page.astro";
import { getBlogPosts, getPostSlug, getPostYear } from "@utils/blog";
import { formatPostDate } from "@utils/date";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getBlogPosts();

  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { year: getPostYear(post), slug: getPostSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = formatPostDate(post.data.date);
const images = post.data.images ?? [];
---

<Page
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <div class="dj-page-header dj-page-header--narrow">
    <div class="dj-page-header__inner">
      <p class="dj-page-eyebrow">BLOG</p>
      <h1 class="dj-page-header__title">{post.data.title}</h1>
      <p class="post-meta">
        <span>{date}</span>
        <span class="post-meta__author">{post.data.author}</span>
      </p>
      {post.data.description && <p class="dj-page-header__lead">{post.data.description}</p>}
    </div>
  </div>

  <article class="dj-prose">
    {
      post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          class="post-hero"
        />
      )
    }

    <Content components={{ Gallery }} />

    {
      images.length > 0 && (
        <div class="post-images">
          {images.map((img: { url: string; alt: string }) => (
            <img
              src={img.url}
              alt={img.alt || ""}
              loading="lazy"
              class="post-gallery-image"
            />
          ))}
        </div>
      )
    }

    <div class="post-back">
      <a href="/blog/">← 記事一覧へ戻る</a>
    </div>
  </article>
</Page>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: baseline;
    margin: 0;
    color: var(--brand-ink-muted);
    font-size: 14px;
  }

  .post-meta__author {
    color: var(--brand-amber);
    font-weight: var(--font-weight-bold);
    font-size: 13px;
  }

  .post-back {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--brand-border);
    font-weight: var(--font-weight-bold);
  }
</style>

<style is:global>
  /* 記事本文中のギャラリーサムネイルは、プロースの img スタイルを上書きして格子状に並べる */
  .dj-prose .post-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--spacing-xs);
    margin: var(--spacing-xl) 0;
  }

  .dj-prose .post-images img {
    width: 100%;
    height: 140px;
    margin: 0;
    border-radius: var(--radius-sm);
    object-fit: cover;
    box-shadow: none;
  }
</style>

---
import Page from "@layouts/Page.astro";
import staffData from "@data/staff.json";
---

<Page
  title="スタッフ"
  description="CoderDojo 奈良を運営しているスタッフの紹介ページです。"
>
  <div class="dj-page-header dj-page-header--narrow">
    <div class="dj-page-header__inner">
      <p class="dj-page-eyebrow">STAFF</p>
      <h1 class="dj-page-header__title">スタッフ紹介</h1>
      <p class="dj-page-header__lead">
        CoderDojo 奈良は、ボランティアのスタッフが運営しています。どんな人が活動しているのかをご紹介します。
      </p>
    </div>
  </div>

  <section class="staff">
    {
      staffData.map((member) => (
        <article class="staff-card">
          <img
            src={member.image}
            alt={member.name}
            class="staff-card__avatar"
            loading="lazy"
          />
          <div class="staff-card__body">
            <h2 class="staff-card__name">{member.name}</h2>
            {member.address && <p class="staff-card__address">{member.address}</p>}
            <p class="staff-card__profile">{member.profile}</p>
            {member.link && (
              <a
                href={member.link}
                class="dj-btn dj-btn--navy-outline staff-card__link"
                target="_blank"
                rel="noopener noreferrer"
              >
                プロフィールを見る
              </a>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Page>

<style>
  .staff {
    max-width: var(--dj-content-measure);
    margin-inline: auto;
    padding: 40px 32px 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .staff-card {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 28px;
    align-items: start;
    padding: 28px;
    border: 1px solid var(--brand-border);
    border-radius: 12px;
    background: #fff;
  }

  .staff-card__avatar {
    width: 128px;
    height: 128px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--brand-surface);
    box-shadow: 0 6px 18px rgba(20, 40, 70, 0.12);
  }

  .staff-card__name {
    margin: 0 0 6px;
    color: var(--brand-navy);
    font-size: 22px;
    font-weight: var(--font-weight-black);
  }

  .staff-card__address {
    margin: 0 0 14px;
    color: var(--brand-ink-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .staff-card__profile {
    margin: 0 0 20px;
    color: var(--brand-ink-sub);
    font-size: 15px;
    line-height: 1.9;
  }

  .staff-card__link {
    padding: 10px 24px;
    font-size: 14px;
  }

  @media (width < 640px) {
    .staff {
      padding-inline: 20px;
    }

    .staff-card {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 18px;
      text-align: center;
    }
  }
</style>

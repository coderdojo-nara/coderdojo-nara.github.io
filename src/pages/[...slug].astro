---
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import ContentPage from "@layouts/ContentPage.astro";
import Page from "@layouts/Page.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export interface Props {
  page: CollectionEntry<"pages">;
}

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  return pages
    .filter((page) => {
      const slug = page.id.replace(/index$/, "");

      // blog は blog/[...page].astro、トップページは index.astro、
      // 参加ページは join.astro、サポーターガイダンスは supporter/guidance.astro が描画する
      return (
        slug !== "blog" && slug !== "join" && slug !== "supporter/guidance" && page.id !== "index"
      );
    })
    .map((page) => {
      const slug = page.id.replace(/index$/, "");

      if (slug.length === 0) return { params: { slug: undefined }, props: { page } };
      return { params: { slug }, props: { page } };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);
const hasSections = page.data.pageSections && page.data.pageSections.length > 0;
const noindex = page.data.sitemap === false;

// トップレベルのセクション名からアイブロウを補う（該当がなければ表示しない）
const topSegment = page.id.split("/")[0];
const eyebrowMap: Record<string, string> = {
  supporter: "SUPPORTER",
  ninja: "NINJA",
};
const eyebrow = eyebrowMap[topSegment];
---

{
  hasSections ? (
    <Page
      frontmatter={page.data}
      noindex={noindex}
      mainNav={mainNavData}
      footer={footerData}
    >
      <Content />
    </Page>
  ) : (
    <ContentPage
      title={page.data.title}
      description={page.data.description}
      eyebrow={eyebrow}
      lead={page.data.description}
      noindex={noindex}
    >
      <Content />
    </ContentPage>
  )
}

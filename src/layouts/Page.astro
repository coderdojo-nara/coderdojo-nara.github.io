---
import SiteFooter from "@components/navigation/site-footer/SiteFooter.astro";
import SiteHeader from "@components/navigation/site-header/SiteHeader.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

import type { ContentBlock } from "../types";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    pageSections?: ContentBlock[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  noindex?: boolean;
  mainNav?: {
    logoText?: string;
    navData?: { name: string; path: string }[];
    [key: string]: unknown;
  };
  footer?: {
    footerText?: string;
    links?: { name: string; path: string }[];
    [key: string]: unknown;
  };
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  noindex = false,
  mainNav = mainNavData,
  footer = footerData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const sections = frontmatter?.pageSections ?? [];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  noindex={noindex}
>
  <slot
    name="head"
    slot="head"
  />
  <SiteHeader
    logoText={mainNav.logoText}
    navData={mainNav.navData}
  />

  <main>
    {
      sections.length > 0 && (
        <div
          data-editable="component"
          data-component="utils/main-component"
          data-prop-sections="pageSections"
        >
          <MainComponent sections={sections} />
        </div>
      )
    }
    <slot />
  </main>
  <SiteFooter
    footerText={footer.footerText}
    navData={mainNav.navData}
    links={footer.links}
  />
</Layout>

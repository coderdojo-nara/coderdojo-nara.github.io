---
/**
 * Courier.astro — 汎用お問い合わせ／申込フォームコンポーネント。
 *
 * fields 定義から「フォーム UI ＋ 確認モーダル ＋ 送信ペイロード」を生成する。
 * 送信は GAS Web App へ（記録＝確定点）、成功時のみ Discord へ二重化通知（best-effort）。
 * 完了は同一ページ内でフォームを successMessage に差し替える（インライン表示）。
 *
 * 設計上の不変条件（壊さない）:
 *   - Content-Type を付けない JSON 文字列 POST（GAS の CORS プリフライト回避）
 *   - ハニーポット・確認モーダル・自動再試行・入力保持のエラー復帰・二重送信抑止
 *   - 記録＝確定点／通知＝best-effort の二層
 */

export type CourierFieldType =
  | 'text'
  | 'email'
  | 'tel'
  | 'url'
  | 'number'
  | 'date'
  | 'time'
  | 'textarea'
  | 'select'
  | 'radio'
  | 'checkbox'
  | 'consent'
  | 'hidden';

/**
 * フィールドの入力バリデーション。空欄は required に委ね、値がある時だけ形式を検査する。
 *   'number'    … 半角数値のみ         ^[0-9]+$
 *   'halfwidth' … 半角のみ（ASCII全般） ^[\x20-\x7E]+$
 *   'email'     … メールアドレス形式
 *   'phone'     … 電話番号（ハイフン有無どちらも可・国内 10〜11 桁）
 *   'none'      … 検査しない（既定）
 */
export type CourierValidation = 'number' | 'halfwidth' | 'email' | 'phone' | 'none';

export interface CourierField {
  /** ペイロードキー／シート列キー */
  name: string;
  /** 表示ラベル（GAS 側のシートヘッダー名にもなる） */
  label: string;
  type: CourierFieldType;
  required?: boolean;
  placeholder?: string;
  /** ラベル下に表示する補足テキスト（記入例・注意書きなど）。aria-describedby で関連付ける */
  description?: string;
  /** input/textarea/select の autocomplete 属性（例 'name' / 'email' / 'tel'）。ブラウザ補完・a11y 向上 */
  autocomplete?: string;
  /** number / date / time の最小値 */
  min?: string | number;
  /** number / date / time の最大値 */
  max?: string | number;
  /** number の刻み幅 */
  step?: string | number;
  /** hidden の固定値 */
  value?: string;
  /**
   * hidden の値をクライアントで自動取得する（value より優先）。
   *   'pageUrl'        … 現在ページの URL（location.href）
   *   'referrer'       … 参照元（document.referrer）
   *   'query:<param>'  … URL クエリの値（例 'query:utm_source'）
   */
  capture?: string;
  /** 入力バリデーション（既定 'none'）。select / radio / checkbox / consent / hidden には適用されない */
  validation?: CourierValidation;
  /** select / radio / checkbox 用の選択肢 */
  options?: string[];
}

export interface CourierLabels {
  /** 内容を確認するボタン（モーダルを開く） */
  submit?: string;
  /** 確認後に送信するボタン */
  confirm?: string;
  /** 修正に戻るボタン */
  cancel?: string;
  /** 送信中のボタン表示 */
  sending?: string;
  /** モーダルの見出し */
  confirmHeading?: string;
  /** 送信失敗時のエラーメッセージ */
  error?: string;
}

export interface Props {
  /** GAS Web App の /exec URL */
  endpoint: string;
  /** ペイロードの type（GAS 側ルーティングキー。例 'contact'） */
  formType: string;
  /** フィールド定義。UI・確認モーダル・ペイロードを生成 */
  fields: CourierField[];
  /** 送信成功後にインライン表示する完了メッセージ（HTML 可・作者が指定する信頼済み文字列） */
  successMessage?: string;
  /** 任意。空／未指定なら Discord 送信をスキップ */
  discordWebhookUrl?: string;
  /** ハニーポット欄の name。既定 'website' */
  honeypotName?: string;
  /** GAS 送信の再試行回数。既定 1（＝最大2回試行） */
  retries?: number;
  /** 文言差し替え */
  labels?: CourierLabels;
}

const {
  endpoint,
  formType,
  fields,
  successMessage = '送信が完了しました。ありがとうございました。',
  discordWebhookUrl = '',
  honeypotName = 'website',
  retries = 1,
  labels = {},
} = Astro.props;

const L = {
  submit: labels.submit ?? '内容を確認する',
  confirm: labels.confirm ?? '送信する',
  cancel: labels.cancel ?? '修正する',
  sending: labels.sending ?? '送信中...',
  confirmHeading: labels.confirmHeading ?? '送信内容の確認',
  error: labels.error ?? '送信に失敗しました。時間をおいて再度お試しください。',
};

// インスタンスごとに一意な id 接頭辞（複数設置に対応）
const uid = `courier-${Math.random().toString(36).slice(2, 9)}`;

// クライアントスクリプトへ渡す設定（フィールドは name/label/type のみ）
const clientConfig = {
  endpoint,
  formType,
  honeypotName,
  retries,
  discordWebhookUrl,
  labels: L,
  fields: fields.map((f) => ({ name: f.name, label: f.label, type: f.type, validation: f.validation ?? 'none', required: f.required ?? false, capture: f.capture ?? '' })),
};
// </script> や < による早期終了・XSS を避けるためエスケープ
const clientConfigJson = JSON.stringify(clientConfig).replace(/</g, '\\u003c');
---

<section class="courier" data-courier aria-live="polite">
  <script is:inline type="application/json" class="courier-config" set:html={clientConfigJson} />

  <form class="courier-form" novalidate>
    {
      fields.map((field) => {
        const fieldId = `${uid}-${field.name}`;
        const descId = `${fieldId}-desc`;
        const errId = `${fieldId}-error`;
        // 補足テキスト（あれば）とエラー枠を aria-describedby でまとめて関連付ける
        const describedBy = [field.description ? descId : null, errId].filter(Boolean).join(' ');

        // hidden：画面に出さない値。value は初期値（capture 指定時はクライアントで上書き）。
        if (field.type === 'hidden') {
          return <input type="hidden" name={field.name} value={field.value ?? ''} />;
        }

        // consent：単一の同意チェックボックス。required で「チェック必須」（ネイティブ検証）。
        if (field.type === 'consent') {
          return (
            <div class="courier-field">
              <label class="courier-consent">
                <input
                  id={fieldId}
                  name={field.name}
                  type="checkbox"
                  required={field.required}
                  aria-describedby={describedBy}
                />
                <span>
                  {field.label}
                  {field.required && <span class="courier-required" aria-hidden="true">*</span>}
                </span>
              </label>
              {field.description && (
                <span class="courier-desc" id={descId}>{field.description}</span>
              )}
              <span class="courier-field-error" data-courier-error={field.name} id={errId} role="alert" hidden />
            </div>
          );
        }

        // ラジオ／チェックボックスは選択肢群として描画（グループラベル＋各選択肢を label で囲む）
        if (field.type === 'radio' || field.type === 'checkbox') {
          const labelId = `${fieldId}-label`;
          // ネストした map 内では型の絞り込みが失われるため、ここで取り出しておく
          const inputType = field.type;
          const isRequired = field.required ?? false;
          return (
            <div class="courier-field" role="group" aria-labelledby={labelId} aria-describedby={describedBy}>
              <span class="courier-label" id={labelId}>
                {field.label}
                {field.required && <span class="courier-required" aria-hidden="true">*</span>}
              </span>
              {field.description && (
                <span class="courier-desc" id={descId}>{field.description}</span>
              )}
              <div class="courier-options">
                {(field.options ?? []).map((opt, i) => {
                  const optId = `${fieldId}-${i}`;
                  return (
                    <label class="courier-option" for={optId}>
                      <input
                        id={optId}
                        name={field.name}
                        type={inputType}
                        value={opt}
                        required={inputType === 'radio' && isRequired}
                      />
                      <span>{opt}</span>
                    </label>
                  );
                })}
              </div>
              <span class="courier-field-error" data-courier-error={field.name} id={errId} role="alert" hidden />
            </div>
          );
        }

        return (
          <div class="courier-field">
            <label class="courier-label" for={fieldId}>
              {field.label}
              {field.required && <span class="courier-required" aria-hidden="true">*</span>}
            </label>
            {field.description && (
              <span class="courier-desc" id={descId}>{field.description}</span>
            )}

            {field.type === 'textarea' ? (
              <textarea
                id={fieldId}
                name={field.name}
                required={field.required}
                placeholder={field.placeholder}
                rows="6"
                autocomplete={field.autocomplete}
                aria-describedby={describedBy}
              />
            ) : field.type === 'select' ? (
              <select id={fieldId} name={field.name} required={field.required} autocomplete={field.autocomplete} aria-describedby={describedBy}>
                <option value="">{field.placeholder ?? '選択してください'}</option>
                {(field.options ?? []).map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            ) : (
              <input
                id={fieldId}
                name={field.name}
                type={field.type}
                required={field.required}
                placeholder={field.placeholder}
                autocomplete={field.autocomplete}
                min={field.min}
                max={field.max}
                step={field.step}
                aria-describedby={describedBy}
              />
            )}

            <span class="courier-field-error" data-courier-error={field.name} id={errId} role="alert" hidden />
          </div>
        );
      })
    }

    {/* ハニーポット（画面外配置のおとり欄。display:none ではなく off-screen） */}
    <div class="courier-honeypot" aria-hidden="true">
      <label for={`${uid}-hp`}>この欄は入力しないでください</label>
      <input id={`${uid}-hp`} name={honeypotName} type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="courier-error" role="alert" hidden>{L.error}</div>

    <button type="button" class="courier-submit">{L.submit}</button>
  </form>

  {/* 送信成功後にインライン表示（作者提供の信頼済み HTML） */}
  <div class="courier-success" hidden tabindex="-1" set:html={successMessage} />

  {/* 確認モーダル */}
  <div class="courier-modal" hidden role="dialog" aria-modal="true" aria-label={L.confirmHeading}>
    <div class="courier-modal__backdrop" data-courier-cancel></div>
    <div class="courier-modal__panel" role="document">
      <h2 class="courier-modal__heading">{L.confirmHeading}</h2>
      <div class="courier-modal__preview"></div>
      <div class="courier-modal__actions">
        <button type="button" class="courier-modal__cancel" data-courier-cancel>{L.cancel}</button>
        <button type="button" class="courier-modal__confirm">{L.confirm}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .courier {
    /* 公開トークン（利用側の CSS 変数で上書き可）→ 内部トークンに解決 */
    --_accent: var(--courier-accent, #2563eb);
    --_accent-contrast: var(--courier-accent-contrast, #ffffff);
    --_text: var(--courier-text, #1f2937);
    --_muted: var(--courier-muted, #6b7280);
    --_border: var(--courier-border, #d1d5db);
    --_bg: var(--courier-bg, #ffffff);
    --_error: var(--courier-error, #dc2626);
    --_radius: var(--courier-radius, 8px);
    --_gap: var(--courier-gap, 1rem);
    --_max-width: var(--courier-max-width, 40rem);

    display: block;
    max-width: var(--_max-width);
    color: var(--_text);
  }

  .courier-form {
    display: flex;
    flex-direction: column;
    gap: var(--_gap);
  }

  .courier-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .courier-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .courier-required {
    color: var(--_error);
    margin-inline-start: 0.25rem;
  }

  /* 補足テキスト（記入例・注意書き） */
  .courier-desc {
    font-size: 0.85rem;
    color: var(--_muted);
  }

  /* フィールド単位のインラインエラー */
  .courier-field-error {
    font-size: 0.85rem;
    color: var(--_error);
  }

  .courier-field-error[hidden] {
    display: none;
  }

  /* 不正な入力欄は枠を強調（aria-invalid をトリガーにする） */
  .courier-form [aria-invalid='true'] {
    border-color: var(--_error);
  }

  .courier-form [aria-invalid='true']:focus {
    outline-color: var(--_error);
  }

  .courier-form input:not([type='radio']):not([type='checkbox']),
  .courier-form textarea,
  .courier-form select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font: inherit;
    color: inherit;
    background: var(--_bg);
    border: 1px solid var(--_border);
    border-radius: var(--_radius);
    box-sizing: border-box;
  }

  .courier-form textarea {
    resize: vertical;
  }

  .courier-form input:not([type='radio']):not([type='checkbox']):focus,
  .courier-form textarea:focus,
  .courier-form select:focus {
    outline: 2px solid var(--_accent);
    outline-offset: 1px;
    border-color: var(--_accent);
  }

  /* ラジオ／チェックボックスの選択肢群 */
  .courier-options {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .courier-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
    cursor: pointer;
  }

  .courier-option input {
    accent-color: var(--_accent);
  }

  /* 単一の同意チェックボックス */
  .courier-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 400;
    cursor: pointer;
  }

  .courier-consent input {
    margin-top: 0.2rem;
    accent-color: var(--_accent);
  }

  /* ハニーポット：display:none ではなく画面外へ（ボットに入力させる） */
  .courier-honeypot {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .courier-error {
    color: var(--_error);
    font-size: 0.9rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--_error);
    border-radius: var(--_radius);
    background: color-mix(in srgb, var(--_error) 8%, transparent);
  }

  .courier-submit,
  .courier-modal__confirm {
    align-self: flex-start;
    padding: 0.7rem 1.5rem;
    font: inherit;
    font-weight: 600;
    color: var(--_accent-contrast);
    background: var(--_accent);
    border: none;
    border-radius: var(--_radius);
    cursor: pointer;
  }

  .courier-submit:disabled,
  .courier-modal__confirm:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .courier-success {
    padding: 1.25rem;
    border: 1px solid var(--_border);
    border-radius: var(--_radius);
    background: color-mix(in srgb, var(--_accent) 6%, var(--_bg));
  }

  /* モーダル */
  .courier-modal {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    z-index: 1000;
  }

  .courier-modal[hidden] {
    display: none;
  }

  .courier-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .courier-modal__panel {
    position: relative;
    width: 100%;
    max-width: 32rem;
    max-height: 85vh;
    overflow-y: auto;
    background: var(--_bg);
    color: var(--_text);
    border-radius: var(--_radius);
    padding: 1.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
  }

  .courier-modal__heading {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .courier-modal__preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .courier-modal__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .courier-modal__cancel {
    padding: 0.7rem 1.25rem;
    font: inherit;
    color: var(--_text);
    background: transparent;
    border: 1px solid var(--_border);
    border-radius: var(--_radius);
    cursor: pointer;
  }

  @media (prefers-color-scheme: dark) {
    .courier {
      --_text: var(--courier-text, #e5e7eb);
      --_muted: var(--courier-muted, #9ca3af);
      --_border: var(--courier-border, #4b5563);
      --_bg: var(--courier-bg, #1f2937);
    }
  }
</style>

<script>
  interface CourierClientField {
    name: string;
    label: string;
    type: string;
    validation: 'number' | 'halfwidth' | 'email' | 'phone' | 'none';
    required: boolean;
    capture: string;
  }

  // バリデーション定義。空欄は required に委ねるため、値がある時だけ検査する。
  // strip 指定時は、その文字を除去してから pattern を適用する（例: 電話番号のハイフン）。
  const VALIDATORS: Record<string, { pattern: RegExp; message: string; strip?: RegExp }> = {
    number: { pattern: /^[0-9]+$/, message: '半角数字で入力してください。' },
    halfwidth: { pattern: /^[\x20-\x7E]+$/, message: '半角文字で入力してください。' },
    email: { pattern: /^[^\s@]+@[^\s@]+\.[^\s@]+$/, message: 'メールアドレスの形式で入力してください。' },
    phone: { pattern: /^0\d{9,10}$/, strip: /[-\s]/g, message: '電話番号を正しい形式で入力してください（例: 03-1234-5678 / 09012345678）。' },
  };
  interface CourierClientConfig {
    endpoint: string;
    formType: string;
    honeypotName: string;
    retries: number;
    discordWebhookUrl: string;
    labels: {
      submit: string;
      confirm: string;
      cancel: string;
      sending: string;
      confirmHeading: string;
      error: string;
    };
    fields: CourierClientField[];
  }

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function jstTimestamp(): string {
    // 'sv-SE' ロケールで yyyy-MM-dd HH:mm:ss 形式（JST）を得る
    return new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Tokyo' });
  }

  // 送信の一意キー（冪等性）。自動再送・再クリックでも同じ値を使い、GAS 側で二重記録を防ぐ。
  function newSubmissionId(): string {
    const c = globalThis.crypto;
    if (c && typeof c.randomUUID === 'function') return c.randomUUID();
    return `sid-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  }

  function initCourier(root: HTMLElement): void {
    const configEl = root.querySelector<HTMLScriptElement>('.courier-config');
    if (!configEl?.textContent) return;
    const cfg: CourierClientConfig = JSON.parse(configEl.textContent);

    // このフォームインスタンスの送信キー。成功でフォームは差し替わるので使い回しの心配はない。
    const submissionId = newSubmissionId();

    const form = root.querySelector<HTMLFormElement>('.courier-form');
    const errorEl = root.querySelector<HTMLElement>('.courier-error');
    const successEl = root.querySelector<HTMLElement>('.courier-success');
    const openBtn = root.querySelector<HTMLButtonElement>('.courier-submit');
    const modal = root.querySelector<HTMLElement>('.courier-modal');
    const preview = root.querySelector<HTMLElement>('.courier-modal__preview');
    const confirmBtn = root.querySelector<HTMLButtonElement>('.courier-modal__confirm');
    if (!form || !errorEl || !successEl || !openBtn || !modal || !preview || !confirmBtn) return;

    const getFieldEl = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;

    const getValue = (name: string): string => {
      const el = getFieldEl(name);
      return el ? el.value.trim() : '';
    };

    // フィールド型に応じた値取得。ラジオは選択1件、チェックボックスは選択を ", " で結合、
    // consent はチェック有無を '同意' / '' で表す。
    const getFieldValue = (field: CourierClientField): string => {
      if (field.type === 'radio' || field.type === 'checkbox') {
        const checked = form.querySelectorAll<HTMLInputElement>(
          `input[name="${CSS.escape(field.name)}"]:checked`
        );
        return Array.from(checked)
          .map((el) => el.value)
          .join(', ');
      }
      if (field.type === 'consent') {
        const el = getFieldEl(field.name) as HTMLInputElement | null;
        return el && el.checked ? '同意' : '';
      }
      return getValue(field.name);
    };

    // hidden の capture 指定を解決してクライアントの文脈を埋める（ページURL・UTM等）。
    const resolveCapture = (capture: string): string => {
      if (capture === 'pageUrl') return location.href;
      if (capture === 'referrer') return document.referrer;
      if (capture.startsWith('query:')) {
        return new URLSearchParams(location.search).get(capture.slice(6)) ?? '';
      }
      return '';
    };
    cfg.fields.forEach((field) => {
      if (field.type !== 'hidden' || !field.capture) return;
      const el = getFieldEl(field.name);
      if (el) el.value = resolveCapture(field.capture);
    });

    // フィールドの「代表要素」。ラジオ／チェックは先頭 input（validity/validationMessage をここで読む）。
    const getPrimaryEl = (field: CourierClientField): HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null => {
      if (field.type === 'radio' || field.type === 'checkbox') {
        return form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(field.name)}"]`);
      }
      return getFieldEl(field.name);
    };

    // フィールドに紐づく入力要素（グループは全 input）。aria-invalid の付与に使う。
    const getFieldControls = (field: CourierClientField): HTMLElement[] => {
      if (field.type === 'radio' || field.type === 'checkbox') {
        return Array.from(form.querySelectorAll<HTMLElement>(`input[name="${CSS.escape(field.name)}"]`));
      }
      const el = getFieldEl(field.name);
      return el ? [el] : [];
    };

    // 値がある時だけ形式検査し、結果を setCustomValidity に載せる（インライン表示の元になる）。
    const applyValidation = (field: CourierClientField): void => {
      const el = getFieldEl(field.name);
      if (!el || typeof el.setCustomValidity !== 'function') return;
      const rule = VALIDATORS[field.validation];
      const value = el.value.trim();
      const target = rule?.strip ? value.replace(rule.strip, '') : value;
      el.setCustomValidity(rule && value !== '' && !rule.pattern.test(target) ? rule.message : '');
    };

    // チェックボックス群の必須は「1つ以上選択」をカスタム検証で表現。
    // ネイティブ required は各チェックが必須になってしまうため使わない。
    const requiredCheckboxNames = new Set(
      cfg.fields.filter((f) => f.type === 'checkbox' && f.required).map((f) => f.name)
    );

    const applyCheckboxRequired = (field: CourierClientField): void => {
      const boxes = Array.from(
        form.querySelectorAll<HTMLInputElement>(`input[name="${CSS.escape(field.name)}"]`)
      );
      if (boxes.length === 0) return;
      const anyChecked = boxes.some((b) => b.checked);
      boxes[0].setCustomValidity(anyChecked ? '' : '1つ以上選択してください。');
    };

    // フィールド単位のインラインエラー表示。
    const getErrorEl = (name: string): HTMLElement | null =>
      root.querySelector<HTMLElement>(`[data-courier-error="${CSS.escape(name)}"]`);

    const clearFieldError = (field: CourierClientField): void => {
      const errEl = getErrorEl(field.name);
      if (errEl) {
        errEl.textContent = '';
        errEl.hidden = true;
      }
      getFieldControls(field).forEach((el) => el.removeAttribute('aria-invalid'));
    };

    const showFieldError = (field: CourierClientField, message: string): void => {
      const errEl = getErrorEl(field.name);
      if (errEl) {
        errEl.textContent = message;
        errEl.hidden = false;
      }
      getFieldControls(field).forEach((el) => el.setAttribute('aria-invalid', 'true'));
    };

    // カスタム検証を反映したうえで validity を読み、インラインエラーを更新する。
    // 戻り値はそのフィールドが妥当かどうか。
    const refreshFieldError = (field: CourierClientField): boolean => {
      applyValidation(field);
      if (requiredCheckboxNames.has(field.name)) applyCheckboxRequired(field);
      const el = getPrimaryEl(field);
      if (!el || typeof el.checkValidity !== 'function') {
        clearFieldError(field);
        return true;
      }
      if (el.validity.valid) {
        clearFieldError(field);
        return true;
      }
      showFieldError(field, el.validationMessage);
      return false;
    };

    // 初回送信後のみライブ検証する（入力途中の早すぎるエラー表示を避ける）。
    let submitted = false;
    cfg.fields.forEach((field) => {
      const evt =
        field.type === 'radio' || field.type === 'checkbox' || field.type === 'select' || field.type === 'consent'
          ? 'change'
          : 'input';
      getFieldControls(field).forEach((el) =>
        el.addEventListener(evt, () => {
          if (submitted) refreshFieldError(field);
        })
      );
    });

    const buildPayload = (): Record<string, string> => {
      const payload: Record<string, string> = { type: cfg.formType, submissionId };
      cfg.fields.forEach((f) => {
        payload[f.name] = getFieldValue(f);
      });
      return payload;
    };

    const openModal = (): void => {
      modal.hidden = false;
      confirmBtn.focus();
    };
    const closeModal = (): void => {
      modal.hidden = true;
    };

    const buildPreview = (): void => {
      preview.innerHTML = cfg.fields
        .filter((f) => f.type !== 'hidden') // 隠し項目は確認画面に出さない
        .map((f) => {
          const value = escapeHtml(getFieldValue(f)).replace(/\n/g, '<br>');
          return `<div><strong>${escapeHtml(f.label)}</strong><br>${value || '<span style="opacity:.6">（未入力）</span>'}</div>`;
        })
        .join('');
    };

    const showSuccess = (): void => {
      closeModal();
      form.hidden = true;
      errorEl.hidden = true;
      successEl.hidden = false;
      successEl.focus();
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const showError = (): void => {
      errorEl.hidden = false;
    };

    const restoreConfirmBtn = (): void => {
      confirmBtn.disabled = false;
      confirmBtn.textContent = cfg.labels.confirm;
    };

    // GAS 送信（記録＝確定点）。失敗時は自動再試行。
    async function sendToGas(payload: Record<string, string>, retries: number): Promise<void> {
      try {
        // Content-Type を付けない＝ simple request にして CORS プリフライトを回避
        const res = await fetch(cfg.endpoint, { method: 'POST', body: JSON.stringify(payload) });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const json = await res.json();
        if (!json || json.ok !== true) throw new Error(json?.error || '送信に失敗しました。');
      } catch (err) {
        if (retries > 0) {
          await sleep(800);
          return sendToGas(payload, retries - 1);
        }
        throw err;
      }
    }

    // Discord 通知（best-effort・GAS 成功時のみ）。失敗は握りつぶす。
    async function notifyDiscord(payload: Record<string, string>, retries: number): Promise<void> {
      if (!cfg.discordWebhookUrl) return;
      const lines = [`受信日時: ${jstTimestamp()}`, `種別: ${cfg.formType}`];
      cfg.fields.forEach((f) => lines.push(`${f.label}: ${payload[f.name] ?? ''}`));
      const content = lines.join('\n').slice(0, 1900); // Discord 2000 文字上限に余裕
      try {
        const res = await fetch(cfg.discordWebhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (!res.ok) throw new Error(`Discord ${res.status}`);
      } catch (err) {
        if (retries > 0) {
          await sleep(500);
          return notifyDiscord(payload, retries - 1);
        }
        console.error('Discord 通知に失敗しました（記録には影響しません）', err);
      }
    }

    const isBot = (): boolean => getValue(cfg.honeypotName) !== '';

    openBtn.addEventListener('click', () => {
      errorEl.hidden = true;
      submitted = true;
      // ハニーポット：値ありはボット。実送信せず完了扱いにする。
      if (isBot()) {
        showSuccess();
        return;
      }
      // 全フィールドを検証し、エラーは項目直下にインライン表示。最初の不正項目へフォーカス。
      let firstInvalid: HTMLElement | null = null;
      cfg.fields.forEach((field) => {
        if (!refreshFieldError(field) && !firstInvalid) firstInvalid = getPrimaryEl(field);
      });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        (firstInvalid as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      buildPreview();
      openModal();
    });

    root.querySelectorAll<HTMLElement>('[data-courier-cancel]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    confirmBtn.addEventListener('click', async () => {
      confirmBtn.disabled = true;
      confirmBtn.textContent = cfg.labels.sending;
      const payload = buildPayload();
      try {
        await sendToGas(payload, cfg.retries); // 確定点
        await notifyDiscord(payload, 1); // 二重化通知（best-effort）
        showSuccess();
      } catch (err) {
        // 成功を偽らない。入力は保持したままエラー表示し、再送可能にする。
        console.error('送信に失敗しました', err);
        closeModal();
        showError();
        restoreConfirmBtn();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.courier').forEach(initCourier);
</script>
